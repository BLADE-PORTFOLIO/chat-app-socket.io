<%- include('layouts/headerGroup') %>

<div class="container">

  <div>
    <img src="/<%= group.image %>" alt="" width="150px" height="150px">
    <p><b><%= group.name %></b></p>

    <p><b>Total Members:- </b> <%= totalMembers %></p>

    <% 
      if( available != 0 ) {
        %>
          <p>Available for <b><%= available %></b> more Members Only.</p>
        <%
      }

      if(isOwner){
        %>
          <p>You are the creator of this group, so you can't join this group</p>
        <%
      } else if(isJoined > 0){
        %>
        <p>You have already joined the <%= group.name %> Group👍.</p>
        <%
      } else if(available === 0){
        %>
        <p>Group already filled👎.</p>
        <%
      } else {
        %>
        <button class="btn btn-primary join-now" data-id="<%= group._id %>">Join Now</button>
        <%
      }
    %>
  </div>

  

  
<%- include('layouts/footerGroup') %>